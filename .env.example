# Copy to .env and fill in. .env is ignored by git.
#   cp .env.example .env
# Load it with exported variables before `openshell provider create --from-existing`:
#   set -a; source .env; set +a

# OpenRouter API key, for the openrouter provider (OpenCode).
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Claude subscription OAuth token, for the claude provider (Claude Code).
# Create one on your machine with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
