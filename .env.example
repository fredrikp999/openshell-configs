# Fallback only: prefer the macOS Keychain, see "Credentials" in docs/setup.md.
#   security add-generic-password -U -s openshell -a CLAUDE_CODE_OAUTH_TOKEN -w
#
# To use .env anyway: copy to .env and fill in. .env is ignored by git.
#   cp .env.example .env && chmod 600 .env
# bin/provider.sh reads it (it refuses a .env others can read). Delete it once
# the provider is created; the gateway keeps its own copy of the key.

# OpenRouter API key, for the openrouter provider (OpenCode).
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Claude subscription OAuth token, for the claude provider (Claude Code).
# Create one on your machine with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
