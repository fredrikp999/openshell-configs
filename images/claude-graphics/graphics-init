#!/bin/sh
# Start the gallery, and copy the image's skills (/usr/local/share/graphics-skills)
# to ~/.claude/skills, each one only if it isn't there yet, so a sandbox keeps
# skills the agent or you edited. $HOME (/sandbox) starts empty. The skills are
# under /usr/local/share, not /opt, because the policy's read-only paths (/usr)
# must cover them. Output goes to stderr, so stdout stays clean for ACP.
set -e
{
  # The gallery page on port 3102 (bin/sandbox.sh --forward 3102); a no-op if it runs.
  graphics-gallery --background || true
  mkdir -p "$HOME/.claude/skills"
  for d in /usr/local/share/graphics-skills/*/; do
    [ -d "$d" ] || continue
    [ -d "$HOME/.claude/skills/$(basename "$d")" ] || cp -r "$d" "$HOME/.claude/skills/"
  done
  # Register the Replicate MCP server when the replicate provider is attached
  # (REPLICATE_API_TOKEN is then a placeholder that the proxy swaps for the
  # token in the Authorization header). Claude Code expands ${...} in headers.
  [ -f "$HOME/.claude.json" ] || cp /etc/claude-start.json "$HOME/.claude.json"
  if [ -n "${REPLICATE_API_TOKEN:-}" ]; then
    python3 -I - "$HOME/.claude.json" <<'PY' || true
import json, sys
p = sys.argv[1]
c = json.load(open(p))
c.setdefault("mcpServers", {})["replicate"] = {
    "type": "sse",
    "url": "https://mcp.replicate.com/sse",
    "headers": {"Authorization": "Bearer ${REPLICATE_API_TOKEN}"},
}
with open(p, "w") as f:
    json.dump(c, f, indent=2)
PY
  fi
} >&2
