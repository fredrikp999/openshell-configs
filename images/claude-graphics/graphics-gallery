async function load() {
  try {
    const r = await fetch("/api/files", {cache: "no-store"});
    const data = await r.json();
    const s = JSON.stringify(data);
    if (s !== sig) { sig = s; files = data; fillDirs(); if (!$("lb").classList.contains("on")) render(); }
  } catch (e) { /* the server may be restarting; try again */ }
}
load(); setInterval(load, 3000);
</script></body></html>
"""


def scan(root):
    """The image files below root, as dicts, skipping hidden folders."""
    out = []
    for base, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in SKIP_DIRS]
        for n in names:
            if n.startswith(".") or os.path.splitext(n)[1].lower() not in TYPES:
                continue
            p = os.path.join(base, n)
            try:
                st = os.stat(p)
            except OSError:
                continue
            rel = os.path.relpath(p, root).replace(os.sep, "/")
            out.append({"path": rel, "name": n, "dir": os.path.dirname(rel),
                        "size": st.st_size, "mtime": int(st.st_mtime)})
    return out


class Handler(BaseHTTPRequestHandler):
    root = "/sandbox"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def send_bytes(self, code, body, ctype, extra=()):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        path = unquote(urlsplit(self.path).path)
        if path in ("/", "/index.html"):
            self.send_bytes(200, PAGE.encode(), "text/html; charset=utf-8", [("Cache-Control", "no-store")])
        elif path == "/api/files":
            body = json.dumps(scan(self.root)).encode()
            self.send_bytes(200, body, "application/json", [("Cache-Control", "no-store")])
        elif path.startswith("/files/"):
            self.send_file(path[len("/files/"):])
        else:
            self.send_bytes(404, b"Not found", "text/plain")

    def send_file(self, rel):
        parts = rel.split("/")
        ext = os.path.splitext(rel)[1].lower()
        # Only image files, no hidden folders, no "..": a path that scan() would not list.
        if (ext not in TYPES or any(p in ("", ".", "..") or p.startswith(".") or p in SKIP_DIRS for p in parts)):
            return self.send_bytes(404, b"Not found", "text/plain")
        full = os.path.realpath(os.path.join(self.root, *parts))
        if not full.startswith(os.path.realpath(self.root) + os.sep) or not os.path.isfile(full):
            return self.send_bytes(404, b"Not found", "text/plain")
        try:
            with open(full, "rb") as f:
                body = f.read()
        except OSError:
            return self.send_bytes(404, b"Not found", "text/plain")
        # `sandbox` stops scripts in an SVG from running if it is opened directly.
        self.send_bytes(200, body, TYPES.get(ext) or mimetypes.guess_type(full)[0] or "application/octet-stream",
                        [("Content-Security-Policy", "sandbox"), ("Cache-Control", "no-cache")])


def listening(host, port):
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex((host, port)) == 0


def daemonize(log):
    """Detach: fork, new session, fork again, stdio to the log."""
    if os.fork():
        os._exit(0)
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDONLY)
    out = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(devnull, 0)
    os.dup2(out, 1)
    os.dup2(out, 2)


def main():
    ap = argparse.ArgumentParser(description="Serve a gallery page for the images in a folder.")
    ap.add_argument("--dir", default="/sandbox", help="folder to show (default /sandbox)")
    ap.add_argument("--port", type=int, default=3102, help="port (default 3102)")
    ap.add_argument("--host", default="127.0.0.1", help="address to bind (default 127.0.0.1)")
    ap.add_argument("--background", action="store_true",
                    help="detach and log to /tmp/graphics-gallery.log; do nothing if the port is in use")
    a = ap.parse_args()
    if not os.path.isdir(a.dir):
        sys.exit("graphics-gallery: not a folder: " + a.dir)
    if a.background:
        if listening("127.0.0.1" if a.host in ("0.0.0.0", "") else a.host, a.port):
            print("graphics-gallery: already running on port %d" % a.port, file=sys.stderr)
            return
        daemonize("/tmp/graphics-gallery.log")
    Handler.root = os.path.abspath(a.dir)
    srv = ThreadingHTTPServer((a.host, a.port), Handler)
    print("graphics-gallery: serving %s on http://%s:%d/" % (Handler.root, a.host, a.port), file=sys.stderr, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
