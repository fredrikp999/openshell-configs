#!/usr/bin/env python3
"""Serve a web page that shows the images in a folder, newest first.

    graphics-gallery [--dir /sandbox] [--port 3102] [--host 127.0.0.1] [--background]

--background detaches from the terminal, logs to /tmp/graphics-gallery.log and does
nothing if something already listens on the port. claude-start runs it that way.

Open the port from your machine with `openshell forward` (bin/sandbox.sh
graphics does that). The page checks for new files every few seconds, so
images show up as the agent writes them. Click one for a large view and
the arrow keys to move between them.

Read-only: GET only, and only image files below --dir are served, not
hidden folders (.claude and the like), node_modules or other files.
"""
import argparse
import json
import mimetypes
import os
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlsplit

TYPES = {
    ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp", ".svg": "image/svg+xml",
    ".avif": "image/avif", ".bmp": "image/bmp", ".tif": "image/tiff",
    ".tiff": "image/tiff",
}
SKIP_DIRS = {"node_modules", "__pycache__"}

PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gallery</title>
<style>
:root { --bg:#fafaf9; --fg:#1c1917; --muted:#78716c; --card:#fff; --line:#e7e5e4; --accent:#2563eb;
        --check:#e7e5e4; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#1c1917; --fg:#f5f5f4; --muted:#a8a29e; --card:#292524; --line:#44403c; --accent:#60a5fa;
          --check:#44403c; } }
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg);
       font:15px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; }
header { position:sticky; top:0; z-index:2; display:flex; flex-wrap:wrap; gap:12px 16px;
         align-items:center; padding:12px 16px; background:var(--bg);
         border-bottom:1px solid var(--line); }
h1 { font-size:17px; margin:0; font-weight:600; }
#count { color:var(--muted); font-size:13px; }
select, input { font:inherit; color:inherit; background:var(--card); border:1px solid var(--line);
                border-radius:6px; padding:6px 8px; }
header .sp { flex:1; }
main { display:grid; gap:14px; padding:16px; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); }
figure { margin:0; background:var(--card); border:1px solid var(--line); border-radius:8px;
         overflow:hidden; cursor:pointer; }
figure:hover, figure:focus-visible { border-color:var(--accent); outline:none; }
.thumb { aspect-ratio:1; display:flex; align-items:center; justify-content:center;
         background:repeating-conic-gradient(var(--check) 0 25%, transparent 0 50%) 0 0/16px 16px; }
.thumb img { max-width:100%; max-height:100%; object-fit:contain; display:block; }
figcaption { padding:8px 10px; font-size:13px; border-top:1px solid var(--line); }
figcaption b { display:block; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
figcaption span { color:var(--muted); font-size:12px; }
#empty { grid-column:1/-1; color:var(--muted); text-align:center; padding:64px 0; }
#lb { position:fixed; inset:0; z-index:5; display:none; flex-direction:column;
      background:rgba(0,0,0,.88); color:#fff; }
#lb.on { display:flex; }
#lb .bar { display:flex; gap:12px; align-items:center; padding:10px 16px; font-size:14px; }
#lb .bar .sp { flex:1; }
#lb a, #lb button { color:#fff; background:none; border:1px solid #fff5; border-radius:6px;
                    padding:5px 10px; font:inherit; cursor:pointer; text-decoration:none; }
#lb .stage { flex:1; min-height:0; display:flex; align-items:center; justify-content:center; padding:0 16px 16px; }
#lb img { max-width:100%; max-height:100%; object-fit:contain;
          background:repeating-conic-gradient(#444 0 25%, #333 0 50%) 0 0/20px 20px; }
</style></head><body>
<header>
  <h1>Gallery</h1><span id="count"></span><span class="sp"></span>
  <select id="dir" aria-label="Folder"></select>
  <select id="sort" aria-label="Sort"><option value="new">Newest first</option>
    <option value="name">Name</option><option value="size">Largest first</option></select>
  <input id="q" type="search" placeholder="Filter by name" aria-label="Filter by name">
</header>
<main id="grid"></main>
<div id="lb" role="dialog" aria-modal="true">
  <div class="bar"><span id="lbname"></span><span class="sp"></span>
    <a id="lbopen" target="_blank" rel="noopener">Open original</a><button id="lbclose">Close (Esc)</button></div>
  <div class="stage"><img id="lbimg" alt=""></div>
</div>
<script>
const $ = id => document.getElementById(id);
let files = [], shown = [], cur = -1, sig = "";
const fmtSize = n => n < 1024 ? n + " B" : n < 1048576 ? (n/1024).toFixed(0) + " KB" : (n/1048576).toFixed(1) + " MB";
const fmtTime = t => new Date(t * 1000).toLocaleString();
const url = f => "/files/" + f.path.split("/").map(encodeURIComponent).join("/") + "?v=" + f.mtime;
function render() {
  const dir = $("dir").value, q = $("q").value.toLowerCase(), sort = $("sort").value;
  shown = files.filter(f => (!dir || f.dir === dir) && f.path.toLowerCase().includes(q));
  shown.sort(sort === "name" ? (a, b) => a.path.localeCompare(b.path)
           : sort === "size" ? (a, b) => b.size - a.size : (a, b) => b.mtime - a.mtime);
  $("count").textContent = shown.length + " of " + files.length + " images";
  const grid = $("grid"); grid.textContent = "";
  if (!shown.length) { const e = document.createElement("div"); e.id = "empty";
    e.textContent = files.length ? "No image matches." : "No images yet."; grid.append(e); }
  shown.forEach((f, i) => {
    const fig = document.createElement("figure"); fig.tabIndex = 0;
    const th = document.createElement("div"); th.className = "thumb";
    const img = document.createElement("img"); img.loading = "lazy"; img.src = url(f); img.alt = f.path;
    th.append(img);
    const cap = document.createElement("figcaption");
    const b = document.createElement("b"); b.textContent = f.name; b.title = f.path;
    const s = document.createElement("span"); s.textContent = fmtSize(f.size) + " · " + fmtTime(f.mtime);
    cap.append(b, s); fig.append(th, cap);
    fig.onclick = () => open(i);
    fig.onkeydown = e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(i); } };
    grid.append(fig);
  });
}
function fillDirs() {
  const sel = $("dir"), keep = sel.value, dirs = [...new Set(files.map(f => f.dir))].sort();
  sel.textContent = "";
  const all = document.createElement("option"); all.value = ""; all.textContent = "All folders"; sel.append(all);
  dirs.forEach(d => { const o = document.createElement("option"); o.value = d; o.textContent = d || "(top folder)"; sel.append(o); });
  sel.value = dirs.includes(keep) ? keep : "";
}
function open(i) {
  if (!shown.length) return;
  cur = (i + shown.length) % shown.length;
  const f = shown[cur];
  $("lbimg").src = url(f); $("lbname").textContent = f.path + "  (" + (cur + 1) + "/" + shown.length + ")";
  $("lbopen").href = url(f); $("lb").classList.add("on");
}
const close = () => { $("lb").classList.remove("on"); $("lbimg").removeAttribute("src"); };
$("lbclose").onclick = close;
$("lb").onclick = e => { if (e.target.id === "lb" || e.target.classList.contains("stage")) close(); };
document.onkeydown = e => {
  if (!$("lb").classList.contains("on")) return;
  if (e.key === "Escape") close();
  else if (e.key === "ArrowRight") open(cur + 1);
  else if (e.key === "ArrowLeft") open(cur - 1);
};
