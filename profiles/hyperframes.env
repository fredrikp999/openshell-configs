# Claude Code with HyperFrames, FFmpeg and a browser; preview on port 3102
#
# The claude-hyperframes image adds HyperFrames, FFmpeg and its skills on top of the
# browser. Ask for the preview on port 3102 and open http://127.0.0.1:3102.
agent=claude
image=claude-hyperframes:latest
policy=hyperframes
forward=3102
