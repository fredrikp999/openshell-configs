# Antigravity CLI with HyperFrames and a browser; preview on port 3102
#
# The agy-hyperframes image has HyperFrames and Python. Its policy lets node and
# Chromium reach the CDNs while agy's login tokens are in the sandbox; see
# docs/agents.md.
agent=agy
image=agy-hyperframes:latest
policy=agy-hyperframes
cmd=agy-start
forward=3102
