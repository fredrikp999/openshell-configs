# Claude Code as an ACP backend for an external Kiro Crew. claude-acp-mkcwd-start
# auto-creates whatever cwd Kiro Crew asks for; the claude-kirocrew-backend
# image adds a symlink for your Mac's Kiro Crew workspace root into the
# sandbox's own writable home, since the sandbox can't create /Users/... itself
# at runtime -- see images/claude-kirocrew-backend/Dockerfile. Build it first:
#   make claude-kirocrew-backend KIROCREW_WORKSPACE_ROOT=/Users/you/dev/kirocrew
agent=claude
image=claude-kirocrew-backend:latest
policy=kirocrew-backend
acp_cmd=claude-acp-mkcwd-start
