# Kiro Crew with no network access (only the Claude API); dashboard on port 5476
#
# Same image as kirocrew, with policies/kirocrew-readonly.yaml: no network rules, so no
# app store, updates or package installs, and apps whose backends need installs won't
# start. For work that only reads and writes files in the sandbox.
agent=claude
image=claude-kirocrew:latest
policy=kirocrew-readonly
cmd=kirocrew-start
forward=5476
