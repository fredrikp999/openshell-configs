# Claude Code with VectorCraft and PhotoCraft (SVG, PDF, photos); gallery on port 3102
#
# The claude-graphics image has the CLIs and MCP servers of VectorCraft and PhotoCraft
# (registered as `vectorcraft` and `photocraft`), Python, uv and graphics-gallery, a web
# page for the images (http://127.0.0.1:3102). The policy lets python3 and uv reach
# PyPI; there is no other network access, except for Replicate: if the provider
# `replicate` exists (bin/provider.sh replicate) it is attached, which adds the
# Replicate MCP server and lets Claude and python3 use the Replicate API with your
# token (the token stays outside the sandbox). Without it there is no Replicate access.
agent=claude
image=claude-graphics:latest
policy=graphics
forward=3102
optional_provider=replicate
